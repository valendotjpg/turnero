# Copiar a .env y ajustar. Los valores por defecto coinciden con docker-compose.yml.
DATABASE_URL="postgresql://turnero:turnero@localhost:5433/turnero?schema=public"
# Sólo si DATABASE_URL pasa por un pooler (p. ej. Neon): la conexión directa,
# que usan las migraciones.
# DIRECT_URL=""

# URL pública de la app: se usa para armar los enlaces de los emails.
APP_URL="http://localhost:3000"

# Servidor de correo. En desarrollo, Mailpit (docker compose) atrapa todo y lo
# muestra en http://localhost:8025. Sin SMTP_URL, los emails sólo se loguean.
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="Turnero <turnos@turnero.test>"

# Secreto para invocar /api/cron (envío pendiente y recordatorios).
CRON_SECRET="cambiar-este-secreto"

# Modo demo (la instancia pública del portfolio): los emails no se envían y
# los datos se reinician todos los días. En un negocio real, dejarlo apagado.
DEMO_MODE="false"
