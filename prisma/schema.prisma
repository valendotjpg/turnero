// =============================================================
// turnero — Modelo de datos
// =============================================================
// Todas las fechas se guardan como timestamptz (UTC). La zona horaria del
// negocio se usa sólo para interpretar los horarios de atención y mostrar
// los turnos.
//
// Regla que Prisma no puede expresar: dos turnos activos del mismo negocio
// no pueden superponerse. Se impone en la base con una restricción EXCLUDE
// (ver la migración inicial), así ni una condición de carrera entre dos
// reservas simultáneas puede romperla.
// =============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id        String   @id @default(cuid())
  name      String
  /// Identificador para la URL pública de reservas: /reservar/<slug>
  slug      String   @unique
  /// Zona horaria IANA, p. ej. "America/Argentina/Buenos_Aires"
  timezone  String   @default("America/Argentina/Buenos_Aires")
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users        User[]
  services     Service[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]
  emails       EmailMessage[]
}

/// Persona que administra el negocio desde el panel.
model User {
  id           String   @id @default(cuid())
  businessId   String
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([businessId])
}

/// Sesión del panel. El navegador guarda un token aleatorio en una cookie
/// httpOnly; acá sólo se guarda su hash SHA-256, así que una copia de la base
/// no alcanza para hacerse pasar por nadie.
model Session {
  /// SHA-256 (hex) del token de la cookie.
  id        String   @id
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int
  /// Precio en centavos para evitar errores de redondeo con decimales.
  priceCents      Int
  /// Un servicio inactivo no se ofrece en la reserva pública, pero sus turnos
  /// pasados se conservan.
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId])
}

/// Franja de atención semanal. Un mismo día puede tener varias franjas
/// (p. ej. 9–13 y 16–20 para un horario cortado).
model WorkingHours {
  id          String @id @default(cuid())
  businessId  String
  /// 0 = domingo … 6 = sábado
  weekday     Int
  /// Minutos desde la medianoche en la zona horaria del negocio (540 = 09:00).
  startMinute Int
  endMinute   Int

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, weekday])
}

/// Bloqueo puntual de la agenda: feriados, vacaciones, un trámite.
model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
  reason     String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id               String            @id @default(cuid())
  businessId       String
  serviceId        String
  startsAt         DateTime          @db.Timestamptz(3)
  /// Se guarda (en vez de calcularse) para que cambiar la duración de un
  /// servicio no altere los turnos ya dados.
  endsAt           DateTime          @db.Timestamptz(3)
  status           AppointmentStatus @default(CONFIRMED)
  customerName     String
  customerEmail    String
  customerPhone    String?
  notes            String?
  /// Token secreto del enlace que recibe el cliente para ver y cancelar su
  /// turno sin necesidad de cuenta. Lo genera la aplicación con un generador
  /// criptográfico (un cuid es predecible y no sirve como secreto).
  cancelToken      String            @unique
  /// Cuándo se encoló el recordatorio. Evita mandarlo dos veces.
  reminderQueuedAt DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  emails   EmailMessage[]

  @@index([businessId, startsAt])
}

enum EmailKind {
  /// Al cliente: su turno quedó reservado.
  BOOKING_CONFIRMATION
  /// Al negocio: entró un turno nuevo.
  BOOKING_NOTICE
  /// Al cliente: confirmación de que canceló.
  CANCELLATION_CONFIRMATION
  /// Al negocio: un cliente canceló.
  CANCELLATION_NOTICE
  /// Al cliente: el negocio canceló su turno.
  CANCELLED_BY_BUSINESS
  /// Al cliente: su turno es dentro de 24 horas.
  REMINDER
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Outbox de emails. Cada email se guarda en la misma transacción que el
/// cambio que lo origina (una reserva, una cancelación) y se envía después:
/// si el servidor de correo falla, el turno igual queda registrado y el email
/// se reintenta. El contenido se arma al encolar, así el email refleja los
/// datos del momento en que ocurrió el hecho.
model EmailMessage {
  id            String      @id @default(cuid())
  businessId    String
  appointmentId String?
  kind          EmailKind
  to            String
  subject       String
  html          String
  text          String
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  /// No se intenta enviar antes de este momento (backoff entre reintentos).
  nextAttemptAt DateTime    @default(now()) @db.Timestamptz(3)
  /// Cuándo un worker lo tomó para enviarlo (status SENDING).
  lockedAt      DateTime?   @db.Timestamptz(3)
  lastError     String?
  sentAt        DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([appointmentId])
}
